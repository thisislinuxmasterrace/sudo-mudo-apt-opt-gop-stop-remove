# linux uses the static musl builds, so no particular glibc is required.
class SudoMudoAptOptGopStopRemove < Formula
  desc "when you really want to nuke the shit out of some files"
  homepage "https://github.com/thisislinuxmasterrace/sudo-mudo-apt-opt-gop-stop-remove"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/thisislinuxmasterrace/sudo-mudo-apt-opt-gop-stop-remove/releases/download/@TAG@/sudo-mudo-apt-opt-gop-stop-remove-@TAG@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64_apple_darwin@"
    end
    on_intel do
      url "https://github.com/thisislinuxmasterrace/sudo-mudo-apt-opt-gop-stop-remove/releases/download/@TAG@/sudo-mudo-apt-opt-gop-stop-remove-@TAG@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64_apple_darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/thisislinuxmasterrace/sudo-mudo-apt-opt-gop-stop-remove/releases/download/@TAG@/sudo-mudo-apt-opt-gop-stop-remove-@TAG@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_aarch64_unknown_linux_musl@"
