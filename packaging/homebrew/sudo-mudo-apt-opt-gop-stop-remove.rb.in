    on_intel do
      url "https://github.com/thisislinuxmasterrace/sudo-mudo-apt-opt-gop-stop-remove/releases/download/@TAG@/sudo-mudo-apt-opt-gop-stop-remove-@TAG@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_x86_64_unknown_linux_musl@"
    end
  end

  def install
    bin.install "mudo"
    man1.install Dir["man/man1/*.1"]
    bash_completion.install "completions/mudo.bash" => "mudo"
    zsh_completion.install "completions/_mudo"
    fish_completion.install "completions/mudo.fish"
  end

  test do
    assert_match "run with sudo", shell_output("#{bin}/mudo apt opt gop stop remove --version 2>&1", 1)
  end
end
